---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';
import { useTranslations } from '../i18n/ui';

const t = useTranslations('es');
const tEn = useTranslations('en');
---

<BaseLayout lang="es" title="404">
  <section class="mx-auto flex min-h-[60vh] max-w-xl flex-col items-center justify-center px-5 py-20 text-center">
    <p
      class="bg-linear-to-r from-accent to-accent-2 bg-clip-text font-display text-7xl font-extrabold text-transparent md:text-8xl"
    >
      404
    </p>
    <h1 class="mt-4 text-2xl font-bold">{t('404.title')}</h1>
    <p class="mt-2 text-muted">{t('404.text')}</p>
    <p class="mt-1 text-sm text-muted" lang="en">{tEn('404.text')}</p>
    <a
      href="/"
      class="mt-8 inline-flex h-11 items-center gap-2 rounded-xl bg-linear-to-r from-accent to-accent-2 px-5 font-semibold text-accent-fg transition-all hover:-translate-y-0.5"
    >
      <Icon name="arrow-left" size={18} />
      {t('404.home')}
    </a>
  </section>
</BaseLayout>
