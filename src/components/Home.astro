---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from './sections/Hero.astro';
import About from './sections/About.astro';
import Skills from './sections/Skills.astro';
import Projects from './sections/Projects.astro';
import Experience from './sections/Experience.astro';
import Contact from './sections/Contact.astro';
import { getExperience, getProjects } from '../lib/content';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const [projects, experience] = await Promise.all([getProjects(lang), getExperience(lang)]);
---

<BaseLayout lang={lang}>
  <Hero lang={lang} projects={projects} />
  <About lang={lang} />
  <Skills lang={lang} />
  <Projects lang={lang} projects={projects} />
  <Experience lang={lang} items={experience} />
  <Contact lang={lang} />
</BaseLayout>
