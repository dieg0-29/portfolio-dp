---
import Icon from './ui/Icon.astro';
import SmartImage from './ui/SmartImage.astro';
import StatusBadge from './ui/StatusBadge.astro';
import { localizePath, useTranslations, type Lang } from '../i18n/ui';
import { slugOf, type Project } from '../lib/content';

interface Props {
  project: Project;
  lang: Lang;
}

const { project, lang } = Astro.props;
const t = useTranslations(lang);
const { title, summary, status, year, tech, image, imageAlt, demo, repo, featured } = project.data;
const href = localizePath(`/projects/${slugOf(project)}/`, lang);
const MAX_TECH = 4;
---

<article
  class="group relative flex h-full flex-col overflow-hidden rounded-2xl border border-line bg-surface transition-all duration-300 focus-within:border-accent/60 hover:-translate-y-1 hover:border-accent/50 hover:shadow-[0_16px_48px_var(--glow)]"
  data-status={status}
>
  <div class="relative">
    <SmartImage
      src={image}
      alt={imageAlt}
      widths={[400, 640, 960]}
      sizes="(min-width: 1024px) 360px, (min-width: 768px) 45vw, 90vw"
      class="aspect-[16/10] bg-surface-2"
      imgClass="transition-transform duration-500 group-hover:scale-[1.03]"
    />
    <div class="absolute top-3 left-3 flex flex-wrap gap-2">
      <StatusBadge status={status} lang={lang} />
      {
        featured && (
          <span class="inline-flex items-center gap-1 rounded-full border border-white/15 bg-slate-950/70 px-2.5 py-1 text-xs font-semibold text-sky-100 backdrop-blur">
            <Icon name="star" size={12} />
            {t('projects.featured')}
          </span>
        )
      }
    </div>
  </div>

  <div class="flex flex-1 flex-col p-6">
    <div class="flex items-baseline justify-between gap-3">
      <h3 class="text-xl font-bold">
        <a href={href} class="after:absolute after:inset-0 after:content-[''] focus-visible:outline-none">
          {title}
        </a>
      </h3>
      <span class="shrink-0 text-sm text-muted tabular-nums">{year}</span>
    </div>
    <p class="mt-2 line-clamp-3 text-pretty text-muted">{summary}</p>

    <ul class="mt-4 flex flex-wrap gap-1.5" aria-label={t('projects.stack')}>
      {
        tech.slice(0, MAX_TECH).map((item) => (
          <li class="rounded-md bg-accent/10 px-2 py-0.5 text-xs font-medium text-accent">{item}</li>
        ))
      }
      {
        tech.length > MAX_TECH && (
          <li class="rounded-md bg-surface-2 px-2 py-0.5 text-xs font-medium text-muted" title={tech.slice(MAX_TECH).join(', ')}>
            +{tech.length - MAX_TECH}
          </li>
        )
      }
    </ul>

    <div class="mt-auto flex items-center gap-2 pt-6">
      <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-accent">
        {t('projects.details')}
        <Icon name="arrow-right" size={16} class="transition-transform group-hover:translate-x-1" />
      </span>
      <div class="relative z-10 ml-auto flex items-center gap-1">
        {
          demo && (
            <a
              href={demo}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex h-9 items-center gap-1.5 rounded-lg px-2.5 text-sm font-medium text-muted transition-colors hover:bg-surface-2 hover:text-fg"
              aria-label={`${t('projects.demo')}: ${title}`}
            >
              <Icon name="external" size={16} />
              {t('projects.demo')}
            </a>
          )
        }
        {
          repo && (
            <a
              href={repo}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex h-9 items-center gap-1.5 rounded-lg px-2.5 text-sm font-medium text-muted transition-colors hover:bg-surface-2 hover:text-fg"
              aria-label={`${t('projects.code')}: ${title}`}
            >
              <Icon name="github" size={16} />
              {t('projects.code')}
            </a>
          )
        }
      </div>
    </div>
  </div>
</article>
