---
interface Props {
  eyebrow: string;
  title: string;
  subtitle?: string;
  id?: string;
}
const { eyebrow, title, subtitle, id } = Astro.props;
---

<header class="mb-10 max-w-2xl md:mb-14" data-reveal>
  <p class="mb-3 flex items-center gap-2 text-sm font-semibold tracking-widest text-accent uppercase">
    <span class="h-px w-8 bg-linear-to-r from-accent to-accent-2" aria-hidden="true"></span>
    {eyebrow}
  </p>
  <h2 id={id} class="text-3xl font-bold text-balance md:text-4xl">{title}</h2>
  {subtitle && <p class="mt-4 text-lg text-pretty text-muted">{subtitle}</p>}
</header>
