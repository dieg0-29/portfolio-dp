---
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  status: 'done' | 'in-progress';
  lang: Lang;
}

const { status, lang } = Astro.props;
const t = useTranslations(lang);
const done = status === 'done';
---

<span
  class="inline-flex items-center gap-1.5 rounded-full border border-white/15 bg-slate-950/70 px-2.5 py-1 text-xs font-semibold text-sky-100 backdrop-blur"
>
  <span class:list={['size-1.5 rounded-full', done ? 'bg-emerald-400' : 'animate-pulse bg-amber-300 motion-reduce:animate-none']} aria-hidden="true"
  ></span>
  {t(`status.${status}`)}
</span>
