---
/**
 * Imagen optimizada con skeleton: el contenedor reserva el espacio (sin saltos de layout),
 * el skeleton se muestra mientras carga y la imagen aparece con fade-in.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Skeleton from './Skeleton.astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
  imgClass?: string;
  widths?: number[];
  sizes?: string;
  loading?: 'lazy' | 'eager';
}

const { src, alt, class: className, imgClass, widths, sizes, loading = 'lazy' } = Astro.props;
---

<div class:list={['smart-img relative overflow-hidden', className]}>
  <Skeleton class="absolute inset-0" />
  <Image
    src={src}
    alt={alt}
    widths={widths}
    sizes={sizes}
    loading={loading}
    fetchpriority={loading === 'eager' ? 'high' : 'auto'}
    class:list={['smart-img__el relative size-full object-cover', imgClass]}
    onload="this.classList.add('is-loaded')"
    onerror="this.classList.add('is-loaded')"
  />
</div>
