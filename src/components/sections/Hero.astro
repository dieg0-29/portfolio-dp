---
import Icon from '../ui/Icon.astro';
import SmartImage from '../ui/SmartImage.astro';
import { site, skills } from '../../data/site';
import { useTranslations, type Lang } from '../../i18n/ui';
import type { Project } from '../../lib/content';

interface Props {
  lang: Lang;
  projects: Project[];
}

const { lang, projects } = Astro.props;
const t = useTranslations(lang);

const inProgress = projects.filter((p) => p.data.status === 'in-progress').length;
const techCount = new Set([...skills.flatMap((s) => s.items), ...projects.flatMap((p) => p.data.tech)]).size;
const stats = [
  { value: projects.length, label: t('hero.statProjects') },
  { value: inProgress, label: t('hero.statInProgress') },
  { value: `${techCount}+`, label: t('hero.statTech') },
];
---

<section id="home" class="relative isolate overflow-hidden" aria-labelledby="hero-title">
  <!-- Fondo decorativo: retícula sutil + halos fríos -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div
      class="absolute inset-0 bg-[linear-gradient(to_right,var(--line)_1px,transparent_1px),linear-gradient(to_bottom,var(--line)_1px,transparent_1px)] bg-size-[56px_56px] opacity-40 mask-[radial-gradient(ellipse_at_top,black_20%,transparent_70%)]"
    >
    </div>
    <div class="absolute -top-40 left-1/2 h-[480px] w-[780px] -translate-x-1/2 rounded-full bg-accent/15 blur-3xl"></div>
    <div class="absolute top-40 -right-40 h-[360px] w-[360px] rounded-full bg-accent-2/15 blur-3xl"></div>
  </div>

  <div
    class="mx-auto grid max-w-6xl items-center gap-12 px-5 pt-16 pb-20 sm:px-8 md:pt-24 md:pb-28 lg:grid-cols-[1.25fr_1fr] lg:gap-16"
  >
    <div data-reveal>
      {
        site.available && (
          <p class="mb-6 inline-flex items-center gap-2 rounded-full border border-line bg-surface/70 px-3.5 py-1.5 text-sm font-medium text-muted backdrop-blur">
            <span class="relative flex size-2.5" aria-hidden="true">
              <span class="absolute inline-flex size-full animate-ping rounded-full bg-emerald-400 opacity-60 motion-reduce:animate-none" />
              <span class="relative inline-flex size-2.5 rounded-full bg-emerald-400" />
            </span>
            {t('hero.available')}
          </p>
        )
      }

      <h1 id="hero-title" class="text-4xl leading-[1.1] font-extrabold sm:text-5xl lg:text-6xl">
        <span class="block text-2xl font-semibold text-muted sm:text-3xl">{t('hero.greeting')}</span>
        <span class="bg-linear-to-r from-fg via-accent to-accent-2 bg-clip-text text-transparent">{site.name}</span>
      </h1>
      <p class="mt-4 font-display text-xl font-semibold text-fg sm:text-2xl">{site.role[lang]}</p>
      <p class="mt-5 max-w-xl text-lg text-pretty text-muted">{site.tagline[lang]}</p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href="#projects"
          class="group inline-flex h-12 items-center gap-2 rounded-xl bg-linear-to-r from-accent to-accent-2 px-6 font-semibold text-accent-fg shadow-[0_8px_30px_var(--glow)] transition-all hover:-translate-y-0.5 hover:shadow-[0_12px_40px_var(--glow)] active:translate-y-0"
        >
          {t('hero.ctaProjects')}
          <Icon name="arrow-right" size={18} class="transition-transform group-hover:translate-x-0.5" />
        </a>
        <a
          href={site.cv[lang]}
          download
          class="inline-flex h-12 items-center gap-2 rounded-xl border border-line bg-surface/70 px-6 font-semibold text-fg backdrop-blur transition-all hover:-translate-y-0.5 hover:border-accent/60 active:translate-y-0"
        >
          <Icon name="download" size={18} />
          {t('hero.ctaCv')}
        </a>
        <div class="flex items-center gap-1 sm:ml-2">
          <a
            href={site.socials.github}
            target="_blank"
            rel="noopener noreferrer"
            class="grid size-12 place-items-center rounded-xl text-muted transition-colors hover:bg-surface-2 hover:text-fg"
            aria-label="GitHub"
          >
            <Icon name="github" />
          </a>
          <a
            href={site.socials.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="grid size-12 place-items-center rounded-xl text-muted transition-colors hover:bg-surface-2 hover:text-fg"
            aria-label="LinkedIn"
          >
            <Icon name="linkedin" />
          </a>
        </div>
      </div>

      <dl class="mt-10 grid max-w-md grid-cols-3 divide-x divide-line rounded-2xl border border-line bg-surface/60 backdrop-blur">
        {
          stats.map((s) => (
            <div class="flex flex-col px-4 py-4 text-center">
              <dt class="text-xs text-muted sm:text-sm">{s.label}</dt>
              <dd class="order-first font-display text-2xl font-bold text-fg sm:text-3xl">{s.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="relative mx-auto w-full max-w-sm lg:max-w-none" data-reveal>
      <div
        class="absolute -inset-3 rounded-[2.25rem] bg-linear-to-br from-accent/40 via-transparent to-accent-2/40 blur-xl"
        aria-hidden="true"
      >
      </div>
      <div class="relative rounded-[2rem] bg-linear-to-br from-accent/60 to-accent-2/60 p-px">
        <SmartImage
          src={site.avatar}
          alt={t('hero.avatarAlt')}
          loading="eager"
          widths={[320, 480, 640]}
          sizes="(min-width: 1024px) 420px, 80vw"
          class="aspect-square rounded-[calc(2rem-1px)] bg-surface"
        />
      </div>
    </div>
  </div>
</section>
