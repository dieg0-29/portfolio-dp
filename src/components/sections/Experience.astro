---
import Icon from '../ui/Icon.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { useTranslations, type Lang } from '../../i18n/ui';
import { formatMonth, type Experience } from '../../lib/content';

interface Props {
  lang: Lang;
  items: Experience[];
}

const { lang, items } = Astro.props;
const t = useTranslations(lang);
---

<section id="experience" class="border-t border-line/70" aria-labelledby="experience-title">
  <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 md:py-28">
    <SectionHeading id="experience-title" eyebrow={t('experience.eyebrow')} title={t('experience.title')} />

    <ol class="relative max-w-3xl space-y-6 before:absolute before:top-2 before:bottom-2 before:left-5 before:w-px before:bg-linear-to-b before:from-accent/60 before:via-line before:to-transparent">
      {
        items.map(({ data }) => {
          const current = !data.end;
          return (
            <li class="relative pl-16" data-reveal>
              <span
                class:list={[
                  'absolute top-5 left-0 grid size-10 place-items-center rounded-xl border bg-surface',
                  current ? 'border-accent/60 text-accent shadow-[0_0_24px_var(--glow)]' : 'border-line text-muted',
                ]}
                aria-hidden="true"
              >
                <Icon name={data.type === 'work' ? 'briefcase' : 'graduation'} size={18} />
              </span>
              <article class="rounded-2xl border border-line bg-surface p-6 transition-colors hover:border-accent/50">
                <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted">
                  <span class="inline-flex items-center gap-1.5">
                    <Icon name="calendar" size={14} />
                    <time datetime={data.start.toISOString().slice(0, 7)}>{formatMonth(data.start, lang)}</time>
                    <span aria-hidden="true">—</span>
                    {current ? (
                      <span class="font-semibold text-accent">{t('experience.present')}</span>
                    ) : (
                      <time datetime={data.end!.toISOString().slice(0, 7)}>{formatMonth(data.end!, lang)}</time>
                    )}
                  </span>
                  {data.location && (
                    <span class="inline-flex items-center gap-1.5">
                      <Icon name="map-pin" size={14} />
                      {data.location}
                    </span>
                  )}
                </p>
                <h3 class="mt-2 text-lg font-semibold">{data.role}</h3>
                <p class="font-medium text-accent">{data.org}</p>
                <p class="mt-3 text-pretty text-muted">{data.summary}</p>
                {data.tech.length > 0 && (
                  <ul class="mt-4 flex flex-wrap gap-1.5">
                    {data.tech.map((item) => (
                      <li class="rounded-md bg-surface-2 px-2 py-0.5 text-xs font-medium text-muted">{item}</li>
                    ))}
                  </ul>
                )}
              </article>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>
